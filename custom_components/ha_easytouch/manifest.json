{
  "domain": "ha_easytouch",
  "name": "Micro-Air EasyTouch",
  "version": "1.0.5",
  "config_flow": true,
  "documentation": "https://github.com/phurth/ha-easytouch",
  "issue_tracker": "https://github.com/phurth/ha-easytouch/issues",
  "integration_type": "device",
